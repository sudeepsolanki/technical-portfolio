FROM mcr.microsoft.com/dotnet/sdk:9.0

WORKDIR /src

RUN apt-get update \
    && apt-get install -y curl unzip procps \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://aka.ms/getvsdbgsh \
    | bash /dev/stdin -v latest -l /vsdbg

COPY ["src/OrderService/OrderService.csproj", "src/OrderService/"]
COPY ["src/Shared/Shared.csproj", "src/Shared/"]
COPY ["src/Shared.Contracts/Shared.Contracts.csproj", "src/Shared.Contracts/"]

RUN dotnet restore "src/OrderService/OrderService.csproj"

COPY src/OrderService/ src/OrderService/
COPY src/Shared/ src/Shared/
COPY src/Shared.Contracts/ src/Shared.Contracts/

RUN dotnet build "src/OrderService/OrderService.csproj" \
    -c Debug

WORKDIR /src/src/OrderService

EXPOSE 5002

ENTRYPOINT ["dotnet", "bin/Debug/net9.0/OrderService.dll"]
